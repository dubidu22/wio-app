{
  "name": "wio-app-tools",
  "private": true,
  "description": "CI tooling for wio-app: OpenAPI lint and the web network check",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "lint:openapi": "REDOCLY_TELEMETRY=off REDOCLY_SUPPRESS_UPDATE_NOTICE=true redocly lint ../api/openapi.yaml --config redocly.yaml",
    "check:web": "node ci/web-network-check.mjs ../app/build/web",
    "test:web-check": "node --test ci/test/web-network-check.test.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.80.0",
    "playwright": "1.63.0"
  }
}
