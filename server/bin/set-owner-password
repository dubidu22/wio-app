#!/usr/bin/env php
<?php

declare(strict_types=1);

// Sets a live owner's password, for example after it was lost (D-115). The
// password is read from standard input, never from the command line:
//
//   php bin/set-owner-password --email=owner@example.org \
//       [--workspace-id=UUID] [--revoke-devices] < password.txt
//
// At a terminal it asks twice with echo off. --revoke-devices signs out all
// of that owner's devices. Prints only ids and a count.

require __DIR__ . '/../vendor/autoload.php';

use Wio\Config\HostConfig;
use Wio\Ops\OpsException;
use Wio\Ops\PasswordPrompt;
use Wio\Ops\SetOwnerPassword;
use Wio\Services;

// On the hosting: config.php outside the web root, written by the deploy (D-161).
HostConfig::load(__DIR__ . '/../config.php');

$options = getopt('', ['email:', 'workspace-id:', 'revoke-devices']);
$email = is_string($options['email'] ?? null) ? $options['email'] : null;
$workspaceId = is_string($options['workspace-id'] ?? null) ? strtolower($options['workspace-id']) : null;
if ($email === null) {
    fwrite(STDERR, 'Usage: php bin/set-owner-password --email=EMAIL [--workspace-id=UUID] [--revoke-devices] < password' . PHP_EOL);
    exit(2);
}

try {
    $services = Services::fromEnvironment();
    $result = (new SetOwnerPassword($services->sql(), $services->clock, $services->hasher()))
        ->run($email, $workspaceId, PasswordPrompt::standardInput()->read(), array_key_exists('revoke-devices', $options));
} catch (OpsException $e) {
    fwrite(STDERR, $e->getMessage() . PHP_EOL);
    exit(1);
} catch (Throwable $e) {
    fwrite(STDERR, 'Failed: ' . $e::class . PHP_EOL);
    exit(1);
}

fwrite(STDOUT, sprintf(
    'workspace_id %s%suser_id %s%srevoked_devices %d%s',
    $result['workspace_id'],
    PHP_EOL,
    $result['user_id'],
    PHP_EOL,
    $result['revoked_devices'],
    PHP_EOL,
));
